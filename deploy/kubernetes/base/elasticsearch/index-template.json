{
  "index_patterns": [
    "logs-stage3-*"
  ],
  "priority": 501,
  "version": 1,
  "_meta": {
    "description": "分布式日志平台最小日志契约 v1",
    "managed_by": "distributed-log-platform"
  },
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "@timestamp": {
          "type": "date_nanos",
          "format": "strict_date_optional_time_nanos||epoch_millis"
        },
        "event_id": {
          "type": "keyword"
        },
        "event": {
          "properties": {
            "sequence": {
              "type": "long"
            }
          }
        },
        "message": {
          "type": "text"
        },
        "log": {
          "properties": {
            "level": {
              "type": "keyword"
            },
            "file": {
              "properties": {
                "path": {
                  "type": "keyword",
                  "ignore_above": 2048
                }
              }
            },
            "offset": {
              "type": "long"
            }
          }
        },
        "service": {
          "properties": {
            "name": {
              "type": "keyword"
            }
          }
        },
        "test_run_id": {
          "type": "keyword",
          "ignore_above": 256
        },
        "kubernetes": {
          "properties": {
            "namespace": {
              "type": "keyword"
            },
            "pod": {
              "properties": {
                "name": {
                  "type": "keyword"
                },
                "uid": {
                  "type": "keyword"
                }
              }
            }
          }
        },
        "container": {
          "properties": {
            "id": {
              "type": "keyword"
            }
          }
        },
        "ingested_at": {
          "type": "date_nanos",
          "format": "strict_date_optional_time_nanos||epoch_millis"
        }
      }
    }
  }
}
